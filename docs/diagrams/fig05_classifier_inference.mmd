flowchart TD
    A["Current 15-Feature Vector x(t)"] --> B["HistGradientBoosting Predictor<br/>(models/aces_health.joblib)"]
    B --> C["Raw Class Logits"]
    C --> D["Calibrated Probabilities<br/>[P_norm, P_watch, P_warn, P_crit]"]
